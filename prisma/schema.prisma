generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  avatar    String?
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  student   Student?
  teacher   Teacher?
}

model Student {
  id          String       @id @default(cuid())
  userId      String       @unique
  rollNumber  String       @unique
  class       String
  section     String?
  dob         DateTime
  guardian    String
  phone       String
  address     String?
  admissionAt DateTime     @default(now())
  attendances Attendance[]
  fees        Fee[]
  marks       Mark[]
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Teacher {
  id         String   @id @default(cuid())
  userId     String   @unique
  employeeId String   @unique
  subject    String
  phone      String
  joinedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  date      DateTime
  status    AttendanceStatus
  remarks   String?
  markedBy  String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
}

model Exam {
  id       String   @id @default(cuid())
  title    String
  subject  String
  class    String
  examDate DateTime
  maxMarks Int      @default(100)
  marks    Mark[]
}

model Mark {
  id        String  @id @default(cuid())
  studentId String
  examId    String
  obtained  Int
  grade     String?
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, examId])
}

model Fee {
  id        String    @id @default(cuid())
  studentId String
  amount    Float
  dueDate   DateTime
  status    FeeStatus @default(PENDING)
  paidAt    DateTime?
  invoiceNo String    @unique
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum FeeStatus {
  PAID
  PENDING
  OVERDUE
}
